{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    },
    "adb": {
      "type": "local",
      "command": ["npx", "-y", "@landicefu/android-adb-mcp-server"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  }
}